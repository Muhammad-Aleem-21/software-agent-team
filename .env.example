# Copy this file to ".env" and fill in your key. Never commit the real .env file.
GROQ_API_KEY=your_groq_api_key_here

# Default model for every agent
MODEL_NAME=openai/gpt-oss-20b
TEMPERATURE=0.2

# Review loop cap: the max number of code versions the Developer may write.
# 3 = first version + up to 2 fixes after the Reviewer says "changes requested".
MAX_ITERATIONS=3

# "llm"  = the supervisor LLM decides who works next (with a rules guardrail)
# "rules" = plain Python routing, no supervisor LLM calls
SUPERVISOR_MODE=llm

# Output limit per call. For reasoning models the "thinking" tokens count too.
MAX_TOKENS=8192
# low / medium / high. Only for reasoning models like gpt-oss; leave EMPTY for other models.
REASONING_EFFORT=low

# Look up each model's price online (cached for 24 h in .cache/). "off" = built-in prices only.
PRICE_LOOKUP=on

# Run traces in LangSmith (smith.langchain.com). Set LANGSMITH_TRACING=true and add your key to record them.
# Note: traces contain your prompts and the generated code.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=software-team-agents
# Only for non-US accounts, e.g. https://eu.api.smith.langchain.com (no trailing slash):
# LANGSMITH_ENDPOINT=

# Optional: give any agent its own model (falls back to MODEL_NAME when empty/unset)
# SUPERVISOR_MODEL=openai/gpt-oss-20b
# PRODUCT_MANAGER_MODEL=openai/gpt-oss-20b
# DEVELOPER_MODEL=openai/gpt-oss-20b
# REVIEWER_MODEL=openai/gpt-oss-20b

# ---- GitHub repo mode (optional; Quick mode needs none of this) ----
# Register a GitHub App (GitHub > Settings > Developer settings > GitHub Apps) and copy these:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=
# This app's own address = the app's "Callback URL" on GitHub (no trailing slash).
# Local: http://localhost:8501   Hosted: https://yourapp.streamlit.app
APP_URL=http://localhost:8501
# Size limits for repo code sent to the model (lower them if Groq rate-limits you)
# REPO_MAX_FILES=8
# REPO_MAX_FILE_CHARS=8000
# REPO_MAX_CONTEXT_CHARS=24000
