# Copy this file to ".env" and fill in your key. Never commit the real .env file.
GROQ_API_KEY=your api key 

# Default model for every agent
MODEL_NAME=yput model
TEMPERATURE=0.2

# "llm"  = the supervisor LLM decides who works next (with a rules guardrail)
# "rules" = plain Python routing, no supervisor LLM calls
SUPERVISOR_MODE=llm

